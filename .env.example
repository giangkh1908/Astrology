# Copy to .env.local. These values are read by the Next.js server.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Used by the Next.js /api/interpret route. Never expose API keys with NEXT_PUBLIC_.
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

# Tài khoản duy nhất được đăng nhập (proxy.ts chặn mọi trang và API khi chưa đăng nhập).
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me-to-a-long-password
# Chuỗi ngẫu nhiên >= 32 ký tự để ký cookie. Tạo: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Neon Postgres (chuỗi "pooled", host có -pooler). Lưu lá số, hội thoại AI, log; portal /admin.
# Thiếu thì chat vẫn chạy nhưng không lưu gì. Tạo bảng: npm run db:migrate
DATABASE_URL=
# Version prompt dùng khi DB chưa có lựa chọn hoặc lỗi (v1 | v2). Mặc định v2.
DEFAULT_PROMPT_VERSION=v2
